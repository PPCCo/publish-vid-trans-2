{
  "schema_version": "1.0",
  "_comment": "Engine adapters. Local-first defaults for Apple Silicon (no CUDA); vendor providers are opt-in via tools.local.json (gitignored). No adapter is required for the framework to validate.",
  "asr": {
    "provider": "mlx-whisper",
    "model": "large-v3",
    "word_alignment": "auto",
    "providers_available": ["mlx-whisper", "faster-whisper", "groq", "assemblyai"],
    "verified": false
  },
  "translation": {
    "provider": "claude",
    "volume_model": "@bedrock-eus1/us.anthropic.claude-sonnet-5",
    "hero_model": "@bedrock-eus2/us.anthropic.claude-opus-4-8",
    "mt_baseline": null,
    "verified": false
  },
  "tts": {
    "default_provider": "piper",
    "per_language": {
      "en": "kokoro",
      "fa": "piper",
      "ur": "piper",
      "ar": "piper",
      "zh": "xtts",
      "fr": "xtts",
      "es": "xtts",
      "pt": "xtts",
      "ru": "xtts"
    },
    "allow_noncommercial_engines": true,
    "providers_available": ["kokoro", "piper", "xtts", "chatterbox", "elevenlabs", "azure", "google"],
    "verified": false
  },
  "external_binaries": {
    "ffmpeg": { "required": true },
    "ffprobe": { "required": true },
    "yt-dlp": { "required": true },
    "rubberband": { "required": false }
  },
  "fonts": {
    "cjk": "Noto Sans CJK",
    "cyrillic": "Noto Sans",
    "arabic": "Noto Sans Arabic"
  },
  "distribution": {
    "_comment": "Phase 6 uploader/promoter adapters. Every platform here is OFF unless BOTH VIDTRANS_PUBLISH_ENABLED=1 (module) and VIDTRANS_EXTERNAL_WRITES=enabled (hook) are set. `sdk` is the Python import probed by `doctor` (absent SDK => graceful PublishDisabled, never a crash). `credentials_ref` names the env-var prefix (see .env.example).",
    "publish_enabled_env": "VIDTRANS_PUBLISH_ENABLED",
    "platforms": {
      "youtube": { "automatable": true, "sdk": "googleapiclient", "credentials_ref": "YT", "quota_units_per_upload": 1600 },
      "x": { "automatable": true, "sdk": "tweepy", "credentials_ref": "X" },
      "telegram": { "automatable": true, "sdk": null, "credentials_ref": "TELEGRAM" },
      "discord": { "automatable": true, "sdk": null, "credentials_ref": "DISCORD" }
    },
    "verified": false
  }
}
