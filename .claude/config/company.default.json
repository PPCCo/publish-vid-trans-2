{
  "schema_version": "1.0",
  "company": {
    "name": "Video Translation House",
    "use_intent": "personal-research"
  },
  "defaults": {
    "target_languages": ["en", "ur", "ar", "fa", "zh", "fr", "es", "pt", "ru"],
    "audio_languages": ["en", "ur", "ar", "fa", "zh", "fr", "es", "pt", "ru"],
    "source_languages_expected": ["fa", "ar", "ur"]
  },
  "human_gates": {
    "transcript_qa": { "required_approvers": 1 },
    "translation_qa": { "required_approvers": 1 },
    "audio_qa": { "required_approvers": 1 },
    "final_qa": { "required_approvers": 1 }
  },
  "approval_defaults": {
    "auto_approve_gates": "false"
  },
  "quality_bars": {
    "captions": {
      "max_chars_per_line_latin": 42,
      "max_chars_per_line_cjk": 16,
      "max_lines_per_cue": 2,
      "max_reading_speed_wpm": 180,
      "max_reading_speed_cjk_cpm": 480,
      "min_cue_duration_ms": 1000,
      "max_cue_duration_ms": 7000
    },
    "audio": {
      "target_lufs": -16.0,
      "max_time_stretch": 1.3,
      "per_cue_drift_tolerance_ms": 150,
      "cumulative_drift_ceiling_ms": 500
    },
    "translation": {
      "glossary_term_hit_rate_required": 1.0
    }
  },
  "revision_policy": {
    "maximum_full_revision_cycles": 3
  },
  "budget": {
    "vendor_spend_ceiling_usd": 0.0,
    "vendor_call_estimated_cost_usd": {
      "elevenlabs": 0.30,
      "azure": 0.02,
      "google": 0.02
    },
    "note": "Vendor (billed) TTS providers are refused until a human raises vendor_spend_ceiling_usd above the running total in budget/ledger.json (company.local.json override). Local engines (kokoro/piper/xtts/chatterbox) are never spend-guarded."
  }
}
