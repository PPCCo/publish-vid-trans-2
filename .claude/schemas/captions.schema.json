{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "captions.schema.json",
  "title": "Per-language captions (canonical)",
  "description": "Canonical translated captions for one target language. Cue timing is inherited verbatim from the source transcript (ANALYSIS B3: cue-level timing is the downstream contract). SRT/VTT are rendered deterministically from this file; this JSON is the single source of truth. `lines` is the reviewer-visible line wrapping; if absent, renderers wrap on demand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "language", "source_language", "script_class", "cues", "created_at"],
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "language": { "type": "string", "description": "Target language (ISO 639-1)." },
    "source_language": { "type": "string" },
    "script_class": { "type": "string", "enum": ["latin", "cyrillic", "rtl", "cjk"] },
    "glossary_id": { "type": ["string", "null"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "description": "Translator provider/model id (agent-authored)." },
        "model": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "has_word_timing": { "type": "boolean" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_ms", "end_ms", "source_text", "target_text"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "source_text": { "type": "string" },
          "target_text": { "type": "string" },
          "translator_confidence": { "type": ["number", "null"] },
          "back_translation": {
            "type": ["string", "null"],
            "description": "Optional round-trip gloss (target->source) the QA step diffs against source_text."
          },
          "flags": { "type": "array", "items": { "type": "string" } },
          "lines": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional pre-wrapped display lines (<=2). Renderers use these verbatim when present."
          }
        }
      }
    },
    "created_at": { "type": "string" },
    "created_by": { "type": ["string", "null"] }
  }
}
