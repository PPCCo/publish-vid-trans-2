{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-metadata.schema.json",
  "title": "Per-project source video metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "url"],
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "url": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "channel": { "type": ["string", "null"] },
    "channel_id": { "type": ["string", "null"] },
    "uploader": { "type": ["string", "null"] },
    "upload_date": { "type": ["string", "null"] },
    "duration_seconds": { "type": ["number", "null"] },
    "detected_language": { "type": ["string", "null"] },
    "language_confidence": { "type": ["number", "null"] },
    "language_source": {
      "type": ["string", "null"],
      "enum": ["auto-detect", "youtube-metadata", "manual", null]
    },
    "dialect": { "type": ["string", "null"] },
    "has_youtube_captions": { "type": "array", "items": { "type": "string" } },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "codec": { "type": ["string", "null"] },
        "fps": { "type": ["number", "null"] },
        "pix_fmt": { "type": ["string", "null"] }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": ["string", "null"] },
        "codec": { "type": ["string", "null"] },
        "sample_rate": { "type": ["integer", "null"] },
        "channels": { "type": ["integer", "null"] }
      }
    },
    "probed_at": { "type": ["string", "null"] },
    "downloaded_at": { "type": ["string", "null"] }
  }
}
