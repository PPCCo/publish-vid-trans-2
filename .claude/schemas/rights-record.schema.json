{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rights-record.schema.json",
  "title": "Per-project rights record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "rights_status", "voice_clone_consent", "updated_at"],
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "rights_status": {
      "type": "string",
      "enum": ["unreviewed", "self-authored", "licensed", "fair-use-claimed", "do-not-distribute"]
    },
    "voice_clone_consent": {
      "type": "boolean",
      "description": "Whether the rights holder consented to cloning the source speaker's voice. Required true before any cloned-voice dub."
    },
    "consent_evidence": { "type": ["string", "null"] },
    "evidence_paths": { "type": "array", "items": { "type": "string" } },
    "reviewer": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "updated_at": { "type": "string" },
    "updated_by": { "type": ["string", "null"] }
  }
}
