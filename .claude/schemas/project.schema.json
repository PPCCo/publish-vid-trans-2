{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Project configuration (project.yaml)",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project_id", "source", "target_languages"],
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "channel": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] }
      }
    },
    "target_languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "audio_languages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Subset of target_languages to also dub (audio deliverables). English is typically required."
    },
    "dubbing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "voice_clone": {
          "type": "boolean",
          "description": "Clone the source speaker's voice. Requires recorded consent in the rights record; default false (neutral voice)."
        }
      }
    },
    "glossary_id": { "type": ["string", "null"] },
    "created_at": { "type": "string" }
  }
}
