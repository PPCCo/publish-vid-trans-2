# publish-vid-trans — credentials & publish switches (EXAMPLE — no real secrets here)
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# Publishing is OFF by default and requires BOTH flags below set (defense in depth):
#   - VIDTRANS_PUBLISH_ENABLED=1        module-level switch inside net/publish.py
#   - VIDTRANS_EXTERNAL_WRITES=enabled  hook-level switch in pre_tool_policy.py
# With either unset, uploaders stay in dry-run / prepare mode and no external write occurs.

# ── Publish switches ────────────────────────────────────────────────────────
VIDTRANS_PUBLISH_ENABLED=0
VIDTRANS_EXTERNAL_WRITES=disabled

# ── Ingest (yt-dlp / vendor fetch) — separate opt-in flag ─────────────────────
VIDTRANS_FETCH_ENABLED=0

# ── YouTube (Data API v3) ─────────────────────────────────────────────────────
# credentials_ref default is "YT_DEFAULT"; per-channel refs use that prefix.
# OAuth installed-app creds (obtain a refresh token once via the consent flow):
YT_DEFAULT_CLIENT_ID=
YT_DEFAULT_CLIENT_SECRET=
YT_DEFAULT_REFRESH_TOKEN=

# ── X / Twitter (API v2 + v1.1 media upload) ─────────────────────────────────
# credentials_ref default is "X". OAuth 1.0a user context (Read+Write app).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Telegram (Bot API) ────────────────────────────────────────────────────────
# credentials_ref default is "TELEGRAM". Bot must be an admin of the target chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# ── Discord (incoming webhook) ────────────────────────────────────────────────
# credentials_ref default is "DISCORD". Treat the webhook URL as a secret.
DISCORD_WEBHOOK_URL=
